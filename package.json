{
  "name": "discord-slash-command-bot",
  "version": "1.0.0",
  "private": true,
  "description": "A deployed web app + Discord bot that reacts to slash commands: verifies Ed25519, records every interaction, applies configurable rules, replies in Discord, mirrors to a second channel, and shows a live dashboard behind login.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node local-server.js",
    "start": "node local-server.js",
    "init-db": "node scripts/init-db.js",
    "register": "node scripts/register-commands.js",
    "hash-password": "node scripts/hash-password.js",
    "test": "node --test"
  },
  "dependencies": {
    "@vercel/functions": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.6.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "dotenv": "^16.4.5"
  }
}
