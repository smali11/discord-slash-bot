# ---------------------------------------------------------------------------
# Discord Slash-Command Bot — environment variables
# Copy this file to `.env` for local dev, and set the same keys in Vercel's
# Project Settings -> Environment Variables for production.
# NEVER commit a filled-in .env. All values below are placeholders.
# ---------------------------------------------------------------------------

# --- Discord (from https://discord.com/developers/applications) ---
# Application -> General Information -> "Application ID"
DISCORD_APPLICATION_ID=000000000000000000
# Application -> General Information -> "Public Key" (used to verify request signatures)
DISCORD_PUBLIC_KEY=your_ed25519_public_key_hex
# Application -> Bot -> "Reset Token" (KEEP SECRET — server-side only)
DISCORD_BOT_TOKEN=your_bot_token
# Optional: override the permission integer used in the bot invite link.
# DISCORD_INVITE_PERMISSIONS=277025508352

# --- Database (Neon or Supabase — free Postgres, no card) ---
# Neon: Dashboard -> Connection string (use the "pooled" connection).
# Supabase: Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Set to false only for a local Postgres without SSL.
DATABASE_SSL=true

# --- Admin login (protects the dashboard) ---
ADMIN_USERNAME=admin
# Recommended: generate a bcrypt hash with `npm run hash-password -- 'yourpassword'`
ADMIN_PASSWORD_HASH=
# Quick-start fallback (plaintext). Use ADMIN_PASSWORD_HASH in production instead.
ADMIN_PASSWORD=change-me-now
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string
# SESSION_TTL_SECONDS=43200

# --- Security ---
# Reject interaction requests whose signed timestamp is older than this (replay guard).
SIGNATURE_MAX_AGE_SECONDS=300

# --- AI triage (optional stretch goal — free tiers only) ---
# provider: gemini | groq | none
AI_PROVIDER=none
AI_API_KEY=
# Optional model override. Defaults: gemini -> gemini-flash-lite-latest, groq -> llama-3.1-8b-instant
AI_MODEL=
# AI_TIMEOUT_MS=8000

# --- Misc ---
# Public URL of the deployed app (used to display the interactions endpoint & invite link).
PUBLIC_BASE_URL=https://your-app.vercel.app
# Optional global Slack webhook fallback if a guild has not set its own mirror.
# DEFAULT_SLACK_WEBHOOK_URL=
